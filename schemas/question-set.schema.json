{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hiroakiyasa/eigo/schemas/question-set.schema.json",
  "title": "TOEIC Part 5 question set for one encyclopedia page",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "page", "analysis", "questions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "id", "title", "image", "sourcePrompt"],
      "properties": {
        "number": { "type": "integer", "minimum": 1, "maximum": 330 },
        "id": { "type": "string", "pattern": "^grammar-master-[0-9]{4}$" },
        "title": { "type": "string", "minLength": 1 },
        "image": { "type": "string", "pattern": "^pages/PAGE_[0-9]{4}\\.webp$" },
        "sourcePrompt": { "type": "string", "pattern": "^source-prompts/PAGE_[0-9]{4}\\.txt$" }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summaryJa", "grammarPoints", "visualEvidence", "commonTraps"],
      "properties": {
        "summaryJa": { "type": "string", "minLength": 20 },
        "grammarPoints": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "visualEvidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "commonTraps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 40,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "format", "prompt", "choices", "correctAnswer", "translationJa", "explanationJa", "focus", "difficulty"],
        "properties": {
          "id": { "type": "string", "pattern": "^PAGE_[0-9]{4}_Q(?:0[1-9]|[1-3][0-9]|40)$" },
          "format": { "enum": ["part5-cloze", "correct-sentence", "meaning-equivalent", "context-completion"] },
          "prompt": { "type": "string", "minLength": 12 },
          "choices": {
            "type": "object",
            "additionalProperties": false,
            "required": ["A", "B", "C", "D"],
            "properties": {
              "A": { "type": "string", "minLength": 1 },
              "B": { "type": "string", "minLength": 1 },
              "C": { "type": "string", "minLength": 1 },
              "D": { "type": "string", "minLength": 1 }
            }
          },
          "correctAnswer": { "enum": ["A", "B", "C", "D"] },
          "translationJa": { "type": "string", "minLength": 1 },
          "explanationJa": { "type": "string", "minLength": 10 },
          "focus": { "type": "string", "minLength": 1 },
          "difficulty": { "enum": ["basic", "intermediate", "advanced"] }
        }
      }
    }
  }
}
